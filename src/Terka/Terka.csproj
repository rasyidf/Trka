<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageId>Terka</PackageId>
    <Version>1.0.0</Version>
    <Authors>rasyidf</Authors>
    <Description>GuessIt for .NET — extract media properties (title, year, season, episode, codec, source, etc.) from video filenames. A C# port of the Python guessit library.</Description>
    <PackageTags>guessit;media;filename;parser;video;movie;episode;metadata</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/rasyidf/Terka</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Vocabulary.cs" Link="Shared\Vocabulary.cs" />
  </ItemGroup>

</Project>
